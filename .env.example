# Claude Haiku 4.5 API key for AI node extraction (src/map-decision-v1/engine/ai-node-extractor.ts).
# Without this, the app automatically falls back to the rule-based extractor
# (src/map-decision-v1/engine/thinking-extractor.ts) and works normally.
ANTHROPIC_API_KEY=

# Upstash Redis (Vercel Marketplace) for anonymous share links
# (src/map-decision-v1/engine/share-store.ts). Connect Upstash to the Vercel
# project (Storage tab > Marketplace) to have these filled in automatically.
# Without them, sharing is disabled and the UI shows a graceful error instead
# of failing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
