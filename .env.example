# Claude Haiku 4.5 API key for AI node extraction (src/map-decision-v1/engine/ai-node-extractor.ts).
# Without this, the app automatically falls back to the rule-based extractor
# (src/map-decision-v1/engine/thinking-extractor.ts) and works normally.
ANTHROPIC_API_KEY=

# Upstash Redis (Vercel Marketplace) for anonymous share links
# (src/map-decision-v1/engine/share-store.ts). Connect Upstash to the Vercel
# project (Storage tab > Marketplace) to have these filled in automatically.
# Without them, sharing is disabled and the UI shows a graceful error instead
# of failing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret used to HMAC-sign generated results before /api/share stores them
# (src/map-decision-v1/engine/result-signature.ts) — proves a shared result
# actually came from this server's generation routes, not just a
# client-supplied payload that merely matches the expected shape. Generate a
# long random value (e.g. `openssl rand -hex 32`) and set it in Vercel's
# environment variables; never commit the real value. Without this set,
# /api/share refuses to save anything (fail-closed) until it's configured.
RESULT_SIGNING_SECRET=
